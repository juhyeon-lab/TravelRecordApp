<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/travel_bg"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingTop="20dp"
        android:paddingEnd="20dp"
        android:paddingBottom="110dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="여행 일정"
            android:textColor="@color/travel_dark"
            android:textSize="25sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="앞으로 갈 여행 날짜와 시간을 선택합니다."
            android:textColor="@color/travel_gray"
            android:textSize="15sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:background="@drawable/bg_card_yellow"
            android:lineSpacingExtra="4dp"
            android:padding="14dp"
            android:text="사용 방법: 예정 여행지를 입력하고 날짜와 시간을 선택한 뒤 일정 저장하기를 누르면 일정이 저장됩니다."
            android:textColor="@color/travel_dark"
            android:textSize="14sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:background="@drawable/bg_card_white"
            android:elevation="4dp"
            android:orientation="vertical"
            android:padding="18dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="예정 여행지"
                android:textColor="@color/travel_dark"
                android:textSize="16sp"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/etSchedulePlace"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="8dp"
                android:background="@drawable/bg_card_blue"
                android:hint="예: 제주도 여행"
                android:inputType="text"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:textColor="@color/travel_dark"
                android:textSize="15sp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:text="날짜 선택"
                android:textColor="@color/travel_dark"
                android:textSize="16sp"
                android:textStyle="bold" />

            <CalendarView
                android:id="@+id/calendarSchedule"
                android:layout_width="match_parent"
                android:layout_height="280dp"
                android:layout_marginTop="8dp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:text="시간 선택"
                android:textColor="@color/travel_dark"
                android:textSize="16sp"
                android:textStyle="bold" />

            <TimePicker
                android:id="@+id/timePickerSchedule"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:timePickerMode="spinner" />

            <TextView
                android:id="@+id/tvSelectedSchedule"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:background="@drawable/bg_card_yellow"
                android:lineSpacingExtra="4dp"
                android:padding="14dp"
                android:text="선택된 일정이 없습니다."
                android:textColor="@color/travel_dark"
                android:textSize="15sp" />

        </LinearLayout>

        <Button
            android:id="@+id/btnSaveSchedule"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:layout_marginTop="20dp"
            android:background="@drawable/bg_primary_button"
            android:text="일정 저장하기"
            android:textAllCaps="false"
            android:textColor="@color/white"
            android:textSize="16sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/btnClearSchedule"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:layout_marginTop="10dp"
            android:backgroundTint="@color/nav_unselected"
            android:text="일정 초기화"
            android:textAllCaps="false"
            android:textColor="@color/travel_dark"
            android:textSize="16sp" />

    </LinearLayout>

</ScrollView>
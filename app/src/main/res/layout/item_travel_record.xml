<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/layoutTravelItem"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="14dp"
    android:layout_marginBottom="4dp"
    android:background="@drawable/bg_card_white"
    android:elevation="4dp"
    android:orientation="horizontal"
    android:padding="16dp">

    <FrameLayout
        android:layout_width="94dp"
        android:layout_height="94dp"
        android:background="@drawable/bg_photo_placeholder">

        <ImageView
            android:id="@+id/ivTravelPhoto"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:contentDescription="여행 사진"
            android:scaleType="centerCrop"
            android:visibility="gone" />

        <TextView
            android:id="@+id/tvPhotoLabel"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:text="PHOTO"
            android:textColor="@color/travel_blue"
            android:textSize="13sp"
            android:textStyle="bold" />

    </FrameLayout>

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tvItemPlace"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="부산 해운대"
            android:textColor="@color/travel_dark"
            android:textSize="18sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvItemDate"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="5dp"
            android:text="2026-06-01"
            android:textColor="@color/travel_blue"
            android:textSize="14sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvItemMemo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:lineSpacingExtra="3dp"
            android:maxLines="2"
            android:text="바다를 보러 간 여행 기록 예시입니다. 나중에 실제 데이터와 사진이 표시됩니다."
            android:textColor="@color/travel_gray"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/tvItemAction"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="상세 보기 준비중"
            android:textColor="@color/travel_orange"
            android:textSize="13sp"
            android:textStyle="bold" />

    </LinearLayout>

</LinearLayout>